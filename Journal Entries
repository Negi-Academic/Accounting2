    : `<span class="yes">✓ पूंजी → मालिक की पूंजी</span><br><span class="yes">✓ नकद/बैंक → संपत्ति</span>`;


    explanation=language==="en"

    ? `Capital represents the owner's investment in the business. It increases owner's equity and the cash or bank balance becomes an asset.`

    : `पूंजी व्यवसाय में मालिक के निवेश को दर्शाती है। इससे मालिक की पूंजी बढ़ती है और नकद या बैंक राशि संपत्ति बन जाती है।`;

}


/* =====================================================
16. DEPRECIATION
===================================================== */

else if(text.includes("depreciation")){

    let asset="Furniture";

    if(text.includes("machinery"))
        asset="Machinery";

    if(text.includes("building"))
        asset="Building";


    let assetHindi={

        Furniture:"फर्नीचर",

        Machinery:"मशीनरी",

        Building:"भवन"

    };


    rows=[

        {
            account:language==="en"
            ? "Depreciation"
            : "मूल्यह्रास",

            debit:amount,
            credit:0
        },

        {
            account:language==="en"
            ? "Accumulated Depreciation - "+asset
            : assetHindi[asset]+" पर संचित मूल्यह्रास",

            debit:0,
            credit:amount
        }

    ];


    narration=language==="en"

    ? `Being depreciation charged on ${asset.toLowerCase()}.`

    : `${language==="hi" ? assetHindi[asset] : asset} पर मूल्यह्रास लगाया गया।`;


    trading=language==="en"

    ? `<span class="no">✗ Normally No</span>`

    : `<span class="no">✗ सामान्यतः नहीं</span>`;


    profitLoss=language==="en"

    ? `<span class="yes">✓ Depreciation → Debit</span>`

    : `<span class="yes">✓ मूल्यह्रास → Debit</span>`;


    balanceSheet=language==="en"

    ? `<span class="yes">✓ Value of ${asset} decreases</span>`

    : `<span class="yes">✓ ${assetHindi[asset]} का मूल्य कम होगा</span>`;


    explanation=language==="en"

    ? `Depreciation is an expense caused by use, time or wear and tear. It is charged to Profit & Loss A/c and reduces the carrying value of the asset.`

    : `मूल्यह्रास उपयोग, समय या घिसावट के कारण संपत्ति के मूल्य में कमी है। इसे Profit & Loss A/c में Debit किया जाता है और संपत्ति का मूल्य कम होता है।`;

}


/* =====================================================
17. BAD DEBTS
===================================================== */

else if(text.includes("bad debt")){

    let person=findPerson(original)||"Debtor";


    rows=[

        {
            account:language==="en" ? "Bad Debts" : "अशोध्य ऋण",
            debit:amount,
            credit:0
        },

        {
            account:person,
            debit:0,
            credit:amount
        }

    ];


    narration=language==="en"

    ? `Being amount due from ${person} written off as bad debt.`

    : `${person} से प्राप्त होने वाली राशि को अशोध्य ऋण माना गया।`;


    trading=language==="en"

    ? `<span class="no">✗ No direct effect</span>`

    : `<span class="no">✗ कोई प्रत्यक्ष प्रभाव नहीं</span>`;


    profitLoss=language==="en"

    ? `<span class="yes">✓ Bad Debts → Debit</span>`

    : `<span class="yes">✓ अशोध्य ऋण → Debit</span>`;


    balanceSheet=language==="en"

    ? `<span class="yes">✓ Debtors decrease</span>`

    : `<span class="yes">✓ देनदार कम होंगे</span>`;


    explanation=language==="en"

    ? `When money cannot be recovered from a debtor, it becomes Bad Debt. Bad Debts are an expense and are charged to Profit & Loss A/c.`

    : `जब देनदार से राशि प्राप्त नहीं हो सकती, तो उसे अशोध्य ऋण माना जाता है। यह व्यवसाय का खर्च है और Profit & Loss A/c में Debit किया जाता है।`;

}


/* =====================================================
18. LOAN
===================================================== */

else if(

    text.includes("loan taken") ||
    text.includes("loan received") ||
    text.includes("borrowed loan")

){

    rows=[

        {
            account:text.includes("bank")
            ? (language==="en" ? "Bank" : "बैंक")
            : (language==="en" ? "Cash" : "नकद"),

            debit:amount,
            credit:0
        },

        {
            account:language==="en" ? "Loan" : "ऋण",
            debit:0,
            credit:amount
        }

    ];


    narration=language==="en"

    ? "Being loan received."

    : "ऋण प्राप्त हुआ।";


    trading=language==="en"

    ? `<span class="no">✗ No Effect</span>`

    : `<span class="no">✗ कोई प्रभाव नहीं</span>`;


    profitLoss=language==="en"

    ? `<span class="no">✗ No direct effect</span>`

    : `<span class="no">✗ कोई प्रत्यक्ष प्रभाव नहीं</span>`;


    balanceSheet=language==="en"

    ? `<span class="yes">✓ Loan → Liability</span><br><span class="yes">✓ Cash/Bank → Asset</span>`

    : `<span class="yes">✓ ऋण → दायित्व</span><br><span class="yes">✓ नकद/बैंक → संपत्ति</span>`;


    explanation=language==="en"

    ? `Loan received creates a liability. Cash or Bank increases and the loan is shown on the liability side of the Balance Sheet.`

    : `ऋण प्राप्त होने से व्यवसाय का दायित्व बढ़ता है। नकद या बैंक राशि बढ़ती है और ऋण Balance Sheet के Liability side में दिखाया जाता है।`;

}


/* =====================================================
19. INTEREST PAID
===================================================== */

else if(text.includes("interest paid")){

    rows=[

        {
            account:language==="en" ? "Interest" : "ब्याज",
            debit:amount,
            credit:0
        },

        {
            account:text.includes("bank")
            ? (language==="en" ? "Bank" : "बैंक")
            : (language==="en" ? "Cash" : "नकद"),

            debit:0,
            credit:amount
        }

    ];


    narration=language==="en"

    ? "Being interest paid."

    : "ब्याज का भुगतान किया गया।";


    trading=language==="en"

    ? `<span class="no">✗ No</span>`

    : `<span class="no">✗ नहीं</span>`;


    profitLoss=language==="en"

    ? `<span class="yes">✓ Interest → Debit</span>`

    : `<span class="yes">✓ ब्याज → Debit</span>`;


    balanceSheet=language==="en"

    ? `<span class="yes">✓ Cash/Bank decreases</span>`

    : `<span class="yes">✓ नकद/बैंक कम होगा</span>`;


    explanation=language==="en"

    ? `Interest paid is a financial expense and is charged to Profit & Loss A/c.`

    : `भुगतान किया गया ब्याज एक वित्तीय खर्च है और इसे Profit & Loss A/c में Debit किया जाता है।`;

}


/* =====================================================
20. INTEREST RECEIVED
===================================================== */

else if(text.includes("interest received")){

    rows=[

        {
            account:text.includes("bank")
            ? (language==="en" ? "Bank" : "बैंक")
            : (language==="en" ? "Cash" : "नकद"),

            debit:amount,
            credit:0
        },

        {
            account:language==="en"
            ? "Interest Received"
            : "प्राप्त ब्याज",

            debit:0,
            credit:amount
        }

    ];


    narration=language==="en"

    ? "Being interest received."

    : "ब्याज प्राप्त हुआ।";


    trading=language==="en"

    ? `<span class="no">✗ No</span>`

    : `<span class="no">✗ नहीं</span>`;


    profitLoss=language==="en"

    ? `<span class="yes">✓ Interest Received → Credit</span>`

    : `<span class="yes">✓ प्राप्त ब्याज → Credit</span>`;


    balanceSheet=language==="en"

    ? `<span class="yes">✓ Cash/Bank increases</span>`

    : `<span class="yes">✓ नकद/बैंक बढ़ेगा</span>`;


    explanation=language==="en"

    ? `Interest received is an income and is credited to Profit & Loss A/c.`

    : `प्राप्त ब्याज एक आय है और इसे Profit & Loss A/c में Credit किया जाता है।`;

}


/* =====================================================
UNKNOWN
===================================================== */

else{

    showError(

        language==="en"

        ? "Transaction not recognised. Try a clearer sentence such as: Goods purchased for cash Rs.10000"

        : "लेन-देन समझ में नहीं आया। कृपया स्पष्ट वाक्य लिखें, जैसे: Goods purchased for cash Rs.10000"

    );

    return;

}


/* =====================================================
SHOW
===================================================== */

hideError();


document.getElementById("transactionText")
    .innerText=original;


showJournal(rows);


document.getElementById("narration")
    .innerText=narration;


document.getElementById("trading")
    .innerHTML=trading;


document.getElementById("profitLoss")
    .innerHTML=profitLoss;


document.getElementById("balanceSheet")
    .innerHTML=balanceSheet;


document.getElementById("explanation")
    .innerHTML=explanation;


document.getElementById("result")
    .style.display="block";

}


/* =====================================================
ERROR
===================================================== */

function showError(message){

    let e=document.getElementById("error");

    e.innerText=message;

    e.style.display="block";

    document.getElementById("result")
        .style.display="none";

}


function hideError(){

    document.getElementById("error")
        .style.display="none";

}


function clearAll(){

    document.getElementById("transaction").value="";

    document.getElementById("result")
        .style.display="none";

    hideError();

}


function useExample(text){

    document.getElementById("transaction").value=text;

    generateEntry();

}

</script>

</body>
</html>
