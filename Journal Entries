<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>EduNegi - Accounting Learning Assistant</title>

<style>
*{
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    margin:0;
    background:#f4f7fb;
    color:#222;
}

.header{
    background:linear-gradient(135deg,#12355b,#1d5d91);
    color:white;
    text-align:center;
    padding:28px 15px;
}

.header h1{
    margin:0;
    font-size:40px;
}

.header h2{
    margin:7px 0;
    font-size:21px;
    font-weight:normal;
}

.header p{
    margin:5px 0 0;
}

.language{
    margin-top:18px;
}

.language button{
    padding:10px 25px;
    border:2px solid white;
    border-radius:25px;
    background:white;
    color:#12355b;
    font-weight:bold;
    cursor:pointer;
    margin:3px;
}

.language button.active{
    background:#ffd54f;
    border-color:#ffd54f;
}

.container{
    max-width:1200px;
    margin:30px auto;
    padding:0 18px;
}

.card{
    background:white;
    padding:25px;
    margin-bottom:20px;
    border-radius:14px;
    box-shadow:0 4px 16px rgba(0,0,0,.07);
}

label{
    display:block;
    font-size:18px;
    font-weight:bold;
    margin-bottom:10px;
}

textarea{
    width:100%;
    min-height:130px;
    padding:15px;
    font-size:17px;
    border:2px solid #d5dde6;
    border-radius:10px;
    resize:vertical;
    outline:none;
}

textarea:focus{
    border-color:#1d5d91;
}

.button-row{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

.main-btn{
    background:#12355b;
    color:white;
    border:none;
    padding:13px 25px;
    border-radius:8px;
    margin-top:15px;
    font-size:16px;
    font-weight:bold;
    cursor:pointer;
}

.clear-btn{
    background:#e7edf3;
    color:#222;
}

.examples{
    margin-top:18px;
    background:#f5f8fb;
    padding:15px;
    border-radius:9px;
    line-height:1.8;
}

.example-btn{
    background:white;
    border:1px solid #ccd5df;
    border-radius:6px;
    padding:7px 11px;
    margin:4px;
    cursor:pointer;
}

.error{
    display:none;
    background:#fff0f0;
    color:#a00000;
    padding:15px;
    border-radius:8px;
    margin-bottom:20px;
}

.result{
    display:none;
}

.card h2{
    color:#12355b;
    border-bottom:2px solid #edf1f5;
    padding-bottom:12px;
    margin-top:0;
}

.transaction{
    background:#eef5fb;
    padding:15px;
    border-radius:8px;
    font-weight:bold;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    border:1px solid #ccd5df;
    padding:12px;
}

th{
    background:#edf2f7;
    text-align:left;
}

.amount{
    text-align:right;
}

.total{
    font-weight:bold;
    background:#f7f9fb;
}

.narration{
    margin-top:18px;
    background:#fff8e6;
    border-left:5px solid #e0a800;
    padding:15px;
    line-height:1.6;
}

.accounts{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.account-box{
    border:1px solid #d8e0e8;
    background:#fafbfd;
    padding:18px;
    border-radius:10px;
    line-height:1.6;
}

.account-box h3{
    color:#12355b;
    margin-top:0;
}

.yes{
    color:#087a35;
    font-weight:bold;
}

.no{
    color:#777;
}

.explanation{
    background:#eef6ff;
    border-left:5px solid #1d5d91;
    padding:18px;
    line-height:1.7;
}

@media(max-width:800px){
    .accounts{
        grid-template-columns:1fr;
    }

    .header h1{
        font-size:30px;
    }
}
</style>
</head>

<body>

<!-- HEADER -->

<div class="header">

    <h1>EduNegi</h1>
    <h1>Faculty of Commerce and Business Management</h1>
    <h2 id="subtitle">
        Accounting Learning Assistant
    </h2>

    <p id="headerDesc">
        Journal Entry • Narration • Final Accounts • Explanation
    </p>

    <div class="language">

        <button id="englishBtn"
                class="active"
                onclick="setLanguage('en')">
            🇬🇧 English
        </button>

        <button id="hindiBtn"
                onclick="setLanguage('hi')">
            🇮🇳 हिंदी
        </button>

    </div>

</div>


<div class="container">


<!-- INPUT -->

<div class="card">

    <label id="inputLabel">
        Enter Business Transaction
    </label>

    <textarea
        id="transaction"
        placeholder="Example: Amount received from Mohan Rs.990 and discount allowed Rs.10">
    </textarea>

    <div class="button-row">

        <button class="main-btn"
                onclick="generateEntry()"
                id="generateBtn">
            Generate Journal Entry
        </button>

        <button class="main-btn clear-btn"
                onclick="clearAll()"
                id="clearBtn">
            Clear
        </button>

    </div>


    <div class="examples">

        <strong id="tryText">Try these examples:</strong>

        <br>

        <button class="example-btn"
            onclick="useExample('Goods purchased for cash Rs.10000')">
            Purchase for Cash
        </button>

        <button class="example-btn"
            onclick="useExample('Goods sold for cash Rs.15000')">
            Cash Sales
        </button>

        <button class="example-btn"
            onclick="useExample('Goods purchased from Rahul Rs.12000')">
            Credit Purchase
        </button>

        <button class="example-btn"
            onclick="useExample('Goods sold to Mohan Rs.18000')">
            Credit Sales
        </button>

        <button class="example-btn"
            onclick="useExample('Salary paid in cash Rs.5000')">
            Salary
        </button>

        <button class="example-btn"
            onclick="useExample('Rent paid Rs.3000')">
            Rent
        </button>

        <button class="example-btn"
            onclick="useExample('Furniture purchased for cash Rs.20000')">
            Furniture
        </button>

        <button class="example-btn"
            onclick="useExample('Amount withdrawn by the proprietor for personal use Rs.3000')">
            Drawings
        </button>

        <button class="example-btn"
            onclick="useExample('Amount received from Mohan Rs.990 and discount allowed Rs.10')">
            Discount Allowed
        </button>

        <button class="example-btn"
            onclick="useExample('Amount paid to Rahul Rs.980 and discount received Rs.20')">
            Discount Received
        </button>

        <button class="example-btn"
            onclick="useExample('Started business with cash Rs.50000')">
            Capital
        </button>

        <button class="example-btn"
            onclick="useExample('Depreciation charged on furniture Rs.2000')">
            Depreciation
        </button>

        <button class="example-btn"
            onclick="useExample('Goods returned to Rahul Rs.2000')">
            Purchase Return
        </button>

        <button class="example-btn"
            onclick="useExample('Goods returned by Mohan Rs.1500')">
            Sales Return
        </button>

    </div>

</div>


<div id="error" class="error"></div>


<!-- RESULT -->

<div id="result" class="result">


<!-- TRANSACTION -->

<div class="card">

    <h2 id="transactionHeading">
        📝 Transaction
    </h2>

    <div class="transaction" id="transactionText"></div>

</div>


<!-- JOURNAL -->

<div class="card">

    <h2 id="journalHeading">
        📒 Journal Entry
    </h2>

    <table>

        <thead>

        <tr>

            <th id="particularHeading">
                Particulars
            </th>

            <th class="amount" id="debitHeading">
                Debit (₹)
            </th>

            <th class="amount" id="creditHeading">
                Credit (₹)
            </th>

        </tr>

        </thead>

        <tbody id="journalBody"></tbody>

    </table>


    <div class="narration">

        <strong id="narrationLabel">
            Narration:
        </strong>

        <span id="narration"></span>

    </div>

</div>


<!-- FINAL ACCOUNTS -->

<div class="card">

    <h2 id="finalHeading">
        📊 Final Accounts Treatment
    </h2>

    <div class="accounts">

        <div class="account-box">

            <h3 id="tradingHeading">
                Trading Account
            </h3>

            <div id="trading"></div>

        </div>


        <div class="account-box">

            <h3 id="profitHeading">
                Profit & Loss Account
            </h3>

            <div id="profitLoss"></div>

        </div>


        <div class="account-box">

            <h3 id="balanceHeading">
                Balance Sheet
            </h3>

            <div id="balanceSheet"></div>

        </div>

    </div>

</div>


<!-- EXPLANATION -->

<div class="card">

    <h2 id="whyHeading">
        🧠 Why This Entry?
    </h2>

    <div class="explanation"
         id="explanation">
    </div>

</div>


</div>

</div>


<script>

/* =====================================================
LANGUAGE
===================================================== */

let language = "en";


const translations = {

    en:{

        subtitle:"Accounting Learning Assistant",

        headerDesc:
        "Journal Entry • Narration • Final Accounts • Explanation",

        inputLabel:
        "Enter Business Transaction",

        placeholder:
        "Example: Amount received from Mohan Rs.990 and discount allowed Rs.10",

        generate:
        "Generate Journal Entry",

        clear:
        "Clear",

        try:
        "Try these examples:",

        transaction:
        "📝 Transaction",

        journal:
        "📒 Journal Entry",

        particulars:
        "Particulars",

        debit:
        "Debit (₹)",

        credit:
        "Credit (₹)",

        narration:
        "Narration:",

        final:
        "📊 Final Accounts Treatment",

        trading:
        "Trading Account",

        profit:
        "Profit & Loss Account",

        balance:
        "Balance Sheet",

        why:
        "🧠 Why This Entry?",

        noEffect:
        "✗ No Effect",

        directExpense:
        "Direct expense",

        indirectExpense:
        "Indirect expense",

        currentAsset:
        "Current Asset",

        currentLiability:
        "Current Liability",

        fixedAsset:
        "Fixed Asset",

        capital:
        "Owner's Equity"

    },


    hi:{

        subtitle:"लेखांकन सीखने का सहायक",

        headerDesc:
        "जर्नल प्रविष्टि • विवरण • अंतिम खाते • व्याख्या",

        inputLabel:
        "व्यावसायिक लेन-देन लिखें",

        placeholder:
        "उदाहरण: Amount received from Mohan Rs.990 and discount allowed Rs.10",

        generate:
        "जर्नल प्रविष्टि बनाएं",

        clear:
        "साफ करें",

        try:
        "इन उदाहरणों को आज़माएं:",

        transaction:
        "📝 लेन-देन",

        journal:
        "📒 जर्नल प्रविष्टि",

        particulars:
        "विवरण",

        debit:
        "नामे (₹)",

        credit:
        "जमा (₹)",

        narration:
        "विवरण:",

        final:
        "📊 अंतिम खातों में उपचार",

        trading:
        "व्यापारिक खाता",

        profit:
        "लाभ एवं हानि खाता",

        balance:
        "स्थिति विवरण",

        why:
        "🧠 यह प्रविष्टि क्यों?",

        noEffect:
        "✗ कोई प्रभाव नहीं",

        directExpense:
        "प्रत्यक्ष खर्च",

        indirectExpense:
        "अप्रत्यक्ष खर्च",

        currentAsset:
        "चालू संपत्ति",

        currentLiability:
        "चालू दायित्व",

        fixedAsset:
        "स्थायी संपत्ति",

        capital:
        "मालिक की पूंजी"

    }

};


/* =====================================================
SET LANGUAGE
===================================================== */

function setLanguage(lang){

    language=lang;

    let t=translations[lang];

    document.getElementById("subtitle").innerText=t.subtitle;

    document.getElementById("headerDesc").innerText=t.headerDesc;

    document.getElementById("inputLabel").innerText=t.inputLabel;

    document.getElementById("transaction").placeholder=t.placeholder;

    document.getElementById("generateBtn").innerText=t.generate;

    document.getElementById("clearBtn").innerText=t.clear;

    document.getElementById("tryText").innerText=t.try;

    document.getElementById("transactionHeading").innerText=t.transaction;

    document.getElementById("journalHeading").innerText=t.journal;

    document.getElementById("particularHeading").innerText=t.particulars;

    document.getElementById("debitHeading").innerText=t.debit;

    document.getElementById("creditHeading").innerText=t.credit;

    document.getElementById("narrationLabel").innerText=t.narration;

    document.getElementById("finalHeading").innerText=t.final;

    document.getElementById("tradingHeading").innerText=t.trading;

    document.getElementById("profitHeading").innerText=t.profit;

    document.getElementById("balanceHeading").innerText=t.balance;

    document.getElementById("whyHeading").innerText=t.why;


    document.getElementById("englishBtn")
        .classList.toggle("active",lang==="en");

    document.getElementById("hindiBtn")
        .classList.toggle("active",lang==="hi");

}


/* =====================================================
AMOUNT
===================================================== */

function getAmounts(text){

    let matches=text.match(
        /(?:₹|rs\.?|inr)?\s*\d[\d,]*(?:\.\d+)?/gi
    );

    if(!matches) return [];

    return matches.map(x=>{

        let n=x
            .replace(/[₹,\s]|rs\.?|inr/gi,"");

        return parseFloat(n);

    }).filter(x=>!isNaN(x));

}


function money(n){

    if(!n) return "";

    return n.toLocaleString("en-IN",{
        maximumFractionDigits:2
    });

}


/* =====================================================
PERSON NAME
Supports FROM and FORM
===================================================== */

function findPerson(text){

    let patterns=[

        /(?:received|amount received)\s+(?:from|form)\s+([A-Za-z]+)/i,

        /(?:paid|amount paid)\s+(?:to)\s+([A-Za-z]+)/i,

        /(?:purchased|purchase)\s+(?:from|form)\s+([A-Za-z]+)/i,

        /(?:sold|sale)\s+(?:to)\s+([A-Za-z]+)/i,

        /returned\s+(?:to|by)\s+([A-Za-z]+)/i

    ];


    for(let pattern of patterns){

        let match=text.match(pattern);

        if(match){

            return match[1].trim();

        }

    }

    return "";

}


/* =====================================================
JOURNAL DISPLAY
===================================================== */

function showJournal(rows){

    let html="";

    let totalDr=0;

    let totalCr=0;


    rows.forEach(r=>{

        totalDr+=r.debit||0;

        totalCr+=r.credit||0;


        html+=`

        <tr>

            <td>

            ${
                r.debit
                ? "<strong>"+r.account+" A/c Dr.</strong>"
                : "&nbsp;&nbsp;&nbsp;&nbsp;To "+r.account+" A/c"
            }

            </td>

            <td class="amount">

            ${r.debit ? money(r.debit) : ""}

            </td>

            <td class="amount">

            ${r.credit ? money(r.credit) : ""}

            </td>

        </tr>

        `;

    });


    html+=`

    <tr class="total">

        <td>Total</td>

        <td class="amount">${money(totalDr)}</td>

        <td class="amount">${money(totalCr)}</td>

    </tr>

    `;


    document.getElementById("journalBody").innerHTML=html;

}


/* =====================================================
MAIN
===================================================== */

function generateEntry(){

    let original=
        document.getElementById("transaction").value.trim();


    if(!original){

        showError(
            language==="en"
            ? "Please enter a business transaction."
            : "कृपया कोई व्यावसायिक लेन-देन लिखें।"
        );

        return;

    }


    let text=original.toLowerCase();

    let amounts=getAmounts(original);

    let amount=amounts[0]||0;

    let rows=[];

    let narration="";

    let trading="";

    let profitLoss="";

    let balanceSheet="";

    let explanation="";


/* =====================================================
1. DRAWINGS
===================================================== */

if(

    text.includes("withdrawn by the proprietor") ||

    text.includes("withdrawn by proprietor") ||

    text.includes("personal use") ||

    text.includes("domestic use") ||

    text.includes("private use") ||

    text.includes("drawings")

){

    rows=[

        {
            account: language==="en" ? "Drawings" : "आहरण",
            debit:amount,
            credit:0
        },

        {
            account: language==="en" ? "Cash" : "नकद",
            debit:0,
            credit:amount
        }

    ];


    narration=language==="en"

    ? "Being cash withdrawn by the proprietor for personal/domestic/private use."

    : "मालिक द्वारा व्यक्तिगत/घरेलू उपयोग के लिए नकद निकाला गया।";


    trading=language==="en"

    ? `<span class="no">✗ No Effect</span><br>Drawings are not a trading expense.`

    : `<span class="no">✗ कोई प्रभाव नहीं</span><br>आहरण व्यापारिक खर्च नहीं है।`;


    profitLoss=language==="en"

    ? `<span class="no">✗ No Effect</span><br>Drawings are not a business expense.`

    : `<span class="no">✗ कोई प्रभाव नहीं</span><br>आहरण व्यवसाय का खर्च नहीं है।`;


    balanceSheet=language==="en"

    ? `<span class="yes">✓ Capital decreases</span><br>Drawings are deducted from owner's capital.<br>Cash decreases by ₹${money(amount)}.`

    : `<span class="yes">✓ पूंजी कम होगी</span><br>आहरण को मालिक की पूंजी से घटाया जाता है।<br>नकद ₹${money(amount)} कम होगा।`;


    explanation=language==="en"

    ? `Money withdrawn by the proprietor for personal use is called <strong>Drawings</strong>. It is not a business expense. Therefore Drawings A/c is debited and Cash A/c is credited. At the end of the year, drawings are deducted from Capital.`

    : `मालिक द्वारा व्यक्तिगत उपयोग के लिए व्यवसाय से निकाली गई राशि को <strong>आहरण (Drawings)</strong> कहते हैं। यह व्यवसाय का खर्च नहीं है। इसलिए Drawings A/c को Debit और Cash A/c को Credit किया जाता है। वर्ष के अंत में आहरण को पूंजी से घटाया जाता है।`;

}


/* =====================================================
2. RECEIVED + DISCOUNT ALLOWED
===================================================== */

else if(

    (
        text.includes("received from") ||
        text.includes("received form") ||
        text.includes("amount received from") ||
        text.includes("amount received form")
    )
    &&
    text.includes("discount allowed")

){

    let cash=amounts[0]||0;

    let discount=amounts[1]||0;

    let total=cash+discount;

    let person=findPerson(original)||"Mohan";


    rows=[

        {
            account:language==="en" ? "Cash" : "नकद",
            debit:cash,
            credit:0
        },

        {
            account:language==="en" ? "Discount Allowed" : "अनुमत छूट",
            debit:discount,
            credit:0
        },

        {
            account:person,
            debit:0,
            credit:total
        }

    ];


    narration=language==="en"

    ? `Being amount received from ${person} and discount allowed.`

    : `${person} से राशि प्राप्त हुई और छूट दी गई।`;


    trading=language==="en"

    ? `<span class="no">✗ No Effect</span>`

    : `<span class="no">✗ कोई प्रभाव नहीं</span>`;


    profitLoss=language==="en"

    ? `<span class="yes">✓ Discount Allowed → Debit</span><br>Discount Allowed is an indirect expense.`

    : `<span class="yes">✓ अनुमत छूट → Debit</span><br>अनुमत छूट एक अप्रत्यक्ष खर्च है।`;


    balanceSheet=language==="en"

    ? `<span class="yes">✓ Cash increases ₹${money(cash)}</span><br><span class="yes">✓ ${person} (Debtor) decreases ₹${money(total)}</span>`

    : `<span class="yes">✓ नकद ₹${money(cash)} बढ़ेगा</span><br><span class="yes">✓ ${person} (देनदार) ₹${money(total)} कम होगा</span>`;


    explanation=language==="en"

    ? `The amount due from ${person} was ₹${money(total)}. The business received ₹${money(cash)} and allowed a discount of ₹${money(discount)}. Therefore Cash A/c and Discount Allowed A/c are debited, while ${person} A/c is credited with the full amount due.`

    : `${person} से कुल ₹${money(total)} प्राप्त होने थे। व्यवसाय को ₹${money(cash)} प्राप्त हुए और ₹${money(discount)} की छूट दी गई। इसलिए Cash A/c और Discount Allowed A/c को Debit किया जाता है तथा ${person} A/c को पूरी राशि ₹${money(total)} से Credit किया जाता है।`;

}


/* =====================================================
3. PAID + DISCOUNT RECEIVED
===================================================== */

else if(

    text.includes("paid to") &&
    text.includes("discount received")

){

    let paid=amounts[0]||0;

    let discount=amounts[1]||0;

    let total=paid+discount;

    let person=findPerson(original)||"Creditor";


    rows=[

        {
            account:person,
            debit:total,
            credit:0
        },

        {
            account:language==="en" ? "Cash" : "नकद",
            debit:0,
            credit:paid
        },

        {
            account:language==="en" ? "Discount Received" : "प्राप्त छूट",
            debit:0,
            credit:discount
        }

    ];


    narration=language==="en"

    ? `Being amount paid to ${person} and discount received.`

    : `${person} को राशि का भुगतान किया गया और छूट प्राप्त हुई।`;


    trading=language==="en"

    ? `<span class="no">✗ No Effect</span>`

    : `<span class="no">✗ कोई प्रभाव नहीं</span>`;


